# ===== 必填（🔒 路由鉴权；不设则 /tasks /agents 拒绝服务）=====
ARGUS_APITOKEN=change-me

# ===== git 平台凭证（至少一项需非空，否则启动校验失败退出；试跑可先填占位符 dummy，
# Argus 会告警降级启动，🔒 路由与轮询仍可用）=====
ARGUS_GITEA_URL=https://git.example.com
ARGUS_GITEA_TOKEN=
ARGUS_GITEA_SECRET=webhook-sign-secret
# 证书过期/自签的内网实例开启（试点环境 git.example.com 需要开）
ARGUS_GITEA_SKIP_TLS=1
#ARGUS_GITHUB_TOKEN=
#ARGUS_GITHUB_SECRET=
#ARGUS_GITLAB_URL=
#ARGUS_GITLAB_TOKEN=
#ARGUS_GITLAB_SECRET=

# ===== bot 账号（须与任何 PR 作者不同，blocking 评审才能 official）=====
ARGUS_BOT_USERNAME=friday

# ===== LLM（OpenAI 兼容端点；builtin 插件依赖此项）=====
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== 行为（可选，默认值见 README §12）=====
#ARGUS_MAX_CONCURRENT_TASKS=2
#ARGUS_TASK_TOKEN_BUDGET=200000
#ARGUS_TASK_RETENTION_DAYS=30
#ARGUS_SKIP_DRAFT=true

# ===== 轮询兜底（平台→本机 webhook 不可达时启用）=====
#ARGUS_POLL_INTERVAL=20s
#ARGUS_POLL_REPOS=gitea:demo-user/argus-pilot
