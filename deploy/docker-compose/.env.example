# Argus docker-compose 环境变量（cp .env.example .env 后填写）
# 宿主端口映射（宿主 8899 被占时改这里，如 argus_minimax 占用场景）
ARGUS_HOST_PORT=8899

# 🔒 路由凭证（必配，未配置时 /tasks /agents 拒绝服务）
ARGUS_APITOKEN=change-me

# bot 账号（自审保护；生产用独立账号，如 friday）
ARGUS_BOT_USERNAME=argus-bot

# 平台接入（同构 ARGUS_<平台>_*：gitea/forgejo/github/gitlab/gitee/gitcode/tencent_code，
# 工蜂前缀 ARGUS_TENCENT_CODE_*；SECRET 必配——空 secret 时 webhook fail-closed 拒绝服务）
ARGUS_GITEA_URL=https://git.example.com
ARGUS_GITEA_TOKEN=
ARGUS_GITEA_SECRET=webhook-secret
# ARGUS_GITEA_SKIP_TLS=1                # 证书过期/自签时开（MITM 风险见 configmap 注释）
# ARGUS_GITEA_CONDITIONAL_REQUESTS=0    # GET 条件请求（ETag/304）v5.4.0 起默认开：GitHub 的 304
                                        # 不计限流预算，poller 常开场景可持续轮询速率抬升；平台
                                        # 不支持 ETag 时透明回退 200。各平台同形，=0 显式关闭。

# LLM（OpenAI 兼容协议；复用 lacus/.env 时可直接引用同值）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 轮询兜底（平台→本机 webhook 不可达时启用）
# ARGUS_POLL_INTERVAL=20s
# ARGUS_POLL_REPOS=gitea:owner/repo

# webhook 启动期幂等确保（v5.4.1，opt-in）：对 POLL_REPOS 逐仓确保回调
# {PUBLIC_URL}/webhook/{platform} 存在 + secret 每次启动重断言（轮换自愈）。
# 替代手工跑 scripts/setup-webhook.sh；失败只告警（poller 兜底不受影响）。
# ARGUS_PUBLIC_URL=http://<平台可达的本机地址>:8899
# ARGUS_ENSURE_WEBHOOK=1
# ARGUS_GITEA_WEBHOOK_EVENTS=pull_request_only,issue_comment   # 平台原生词表覆盖（默认内置）

# 结果上报 sink（v3.9.0，可选；审查完成后 push 给 review-service 的承接端点，
# 其前端「Argus 审查」页展示任务清单与意见。URL 非空即启用；失败只告警不阻断审查）
# ARGUS_SINK_URL=http://review-service:8000/api/v1/argus/reviews
# ARGUS_SINK_TOKEN=change-me-argus-ingest-token

# OCR delegate 委托前置（v3.9.0，可选；OCR 端零 LLM、零凭证——文件分诊+仓库规则
# 注入 R4，审查循环仍由 argus 执行。取消注释启用；compose 已挂载 /opt/argus/bin/ocr。
# 原始产物留档 compose 已固定 ARGUS_OCR_HISTORY_DIR=/data/ocr-history（宿主
# ./data/ocr-history），本地裸跑可按需设置；不设则不留档）
# ARGUS_OCR_BIN=/opt/argus/bin/ocr
# ARGUS_OCR_TIMEOUT=90s

# OCR MCP 通道（v3.9.0，可选；compose 的 ocrshim sidecar 服务消费以下变量——
# OCR 全权审查形态，插件条目 `ocr` 在 plugins.yaml 里指向 http://ocrshim:8090/mcp。
# OCR 的 LLM 凭证即上面的 OPENAI_BASE_URL/OPENAI_API_KEY（env_file 注入 ocrshim 容器，
# 白名单按名透传给 OCR 子进程；凭证不进待审工作树内的插件子进程；compose 的 sidecar 启动
# 参数已在 compose.yaml command 里固化，无需额外变量。OCR 原始输出留档由 command
# 的 -history-dir 固化到 /data/ocr-history（宿主 ./data/ocr-history），与 delegate 留档同目录）

# ocrshim 共享密钥（可选但建议；v3.9.0 审查修复：compose 里 ocrshim 绑的是容器
# 全接口——argus 经 docker 网络访问它必须如此——网络隔离不足以限定"只有 argus"。
# 设一个随机串后 shim 自动启用 Bearer 门；再在 plugins.yaml 的 ocr 条目取消
# auth_token_env: OCRSHIM_TOKEN 注释即两侧配对。留空 = 不鉴权，行为同旧版）
# OCRSHIM_TOKEN=
