# Argus docker-compose 环境变量（复制为 .env 后填写）
# chmod 600 .env

# ---- 鉴权（fail-closed：全空则 /tasks 等 🔒 路由 503）----
ARGUS_APITOKEN=change-me-admin-token
# 多 token 分级：tok1:admin,tok2:ci,tok3:read
# ARGUS_API_TOKENS=

# 会话登录首管（可选；与静态 token 并存）
ARGUS_BOOTSTRAP_ADMIN_USER=admin
ARGUS_BOOTSTRAP_ADMIN_PASS=change-me-strong-pass

# ---- 平台凭据（至少一项）----
# ARGUS_GITHUB_TOKEN=
# ARGUS_GITEA_URL=https://git.example.com
# ARGUS_GITEA_TOKEN=
# ARGUS_GITLAB_URL=
# ARGUS_GITLAB_TOKEN=
# ARGUS_GITEE_TOKEN=
# GitHub App（替代 PAT）
# ARGUS_GITHUB_APP_ID=
# ARGUS_GITHUB_APP_PRIVATE_KEY=
# ARGUS_GITHUB_APP_INSTALLATION_ID=

# ---- LLM ----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# 出站同意（外部端点建议显式）
ARGUS_LLM_EGRESS_CONSENT=yes

# ---- 修复环（可选）----
# ARGUS_FIX_AGENT=claude
# ARGUS_FIX_VERIFY_CMD=docker run --rm -v {dir}:/w -w /w golang:1.24 go test ./...
# ARGUS_FIX_PUSH=confirm

# ---- 轮询兜底（webhook 不可达时）----
# ARGUS_POLL_REPOS=gitea:acme/app,github:acme/app
# ARGUS_POLL_INTERVAL=60s

# ---- 端口 ----
ARGUS_HOST_PORT=8899

# ---- 其它 ----
ARGUS_BOT_USERNAME=argus-bot
ARGUS_MAX_CONCURRENT_TASKS=2
ARGUS_TASK_RETENTION_DAYS=30
